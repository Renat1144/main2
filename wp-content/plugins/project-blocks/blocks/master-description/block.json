{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "project-blocks/master-description",
  "version": "1.0.0",
  "title": "Описание мастер-класса",
  "category": "project-blocks",
  "icon": "text-page",
  "description": "Описание материала с фирменной текстовой карточкой.",
  "textdomain": "project-blocks",
  "attributes": {
    "kicker": { "type": "string", "default": "О материале" },
    "title": { "type": "string", "default": "Описание мастер-класса" },
    "content": { "type": "string", "default": "Описание мастер-класса будет добавлено позже." },
    "typography": { "type": "object", "default": {} }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "project-blocks-editor",
  "style": "file:./style.css",
  "editorStyle": ["project-blocks-editor-foundations", "file:./editor.css"],
  "render": "file:./render.php"
}
