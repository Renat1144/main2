{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "project-blocks/master-audience",
  "version": "1.0.0",
  "title": "Аудитория мастер-класса",
  "category": "project-blocks",
  "icon": "groups",
  "description": "Четыре защищённые карточки аудитории с редактируемыми текстами.",
  "textdomain": "project-blocks",
  "attributes": {
    "kicker": { "type": "string", "default": "Направление" },
    "title": { "type": "string", "default": "Для кого этот мастер-класс" },
    "items": {
      "type": "array",
      "default": [
        { "number": "01", "text": "" },
        { "number": "02", "text": "" },
        { "number": "03", "text": "" },
        { "number": "04", "text": "" }
      ]
    },
    "typography": { "type": "object", "default": {} }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "project-blocks-editor",
  "style": "file:./style.css",
  "editorStyle": ["project-blocks-editor-foundations", "file:./editor.css"],
  "render": "file:./render.php"
}
