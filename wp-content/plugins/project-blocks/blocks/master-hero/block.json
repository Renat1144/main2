{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "project-blocks/master-hero",
  "version": "1.0.0",
  "title": "Первый экран мастер-класса",
  "category": "project-blocks",
  "icon": "cover-image",
  "description": "Первый экран с заголовком, текстовой карточкой, изображением и кнопкой.",
  "textdomain": "project-blocks",
  "attributes": {
    "number": { "type": "string", "default": "01" },
    "label": { "type": "string", "default": "Мастер-класс" },
    "title": { "type": "string", "default": "Название мастер-класса" },
    "description": { "type": "string", "default": "" },
    "cardTitle": { "type": "string", "default": "Текст будет добавлен" },
    "cardContent": { "type": "string", "default": "" },
    "imageId": { "type": "number", "default": 0 },
    "imageUrl": { "type": "string", "default": "" },
    "imageAlt": { "type": "string", "default": "Обложка мастер-класса" },
    "imageCaption": { "type": "string", "default": "" },
    "imagePlaceholderCaption": { "type": "string", "default": "Обложка мастер-класса" },
    "buttonText": { "type": "string", "default": "" },
    "buttonUrl": { "type": "string", "default": "" },
    "typography": { "type": "object", "default": {} }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "project-blocks-editor",
  "style": "file:./style.css",
  "editorStyle": ["project-blocks-editor-foundations", "file:./editor.css"],
  "render": "file:./render.php"
}
