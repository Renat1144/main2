{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "project-blocks/master-offer",
  "version": "1.0.0",
  "title": "Предложение мастер-класса",
  "category": "project-blocks",
  "icon": "tickets-alt",
  "description": "Финальное предложение, состав, цена и кнопка.",
  "textdomain": "project-blocks",
  "attributes": {
    "number": { "type": "string", "default": "02" },
    "label": { "type": "string", "default": "Доступ к материалу" },
    "title": { "type": "string", "default": "Название мастер-класса" },
    "price": { "type": "string", "default": "Стоимость будет добавлена" },
    "compositionTitle": { "type": "string", "default": "Состав будет добавлен" },
    "items": {
      "type": "array",
      "default": [
        { "number": "01", "text": "" },
        { "number": "02", "text": "" },
        { "number": "03", "text": "" }
      ]
    },
    "buttonText": { "type": "string", "default": "Оплатить" },
    "buttonUrl": { "type": "string", "default": "" },
    "typography": { "type": "object", "default": {} }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": false,
    "spacing": false,
    "typography": false
  },
  "editorScript": "project-blocks-editor",
  "style": "file:./style.css",
  "editorStyle": ["project-blocks-editor-foundations", "file:./editor.css"],
  "render": "file:./render.php"
}
