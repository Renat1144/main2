    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Акцентный",
          "fontFamily": "\"Bodoni 72\", Didot, \"Times New Roman\", serif"
        },
        {
          "slug": "body",
          "name": "Основной",
          "fontFamily": "\"Avenir Next\", Avenir, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "utility",
          "name": "Служебный",
          "fontFamily": "Inter, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Маленький", "size": "12px" },
        { "slug": "normal", "name": "Основной", "size": "17px" },
        { "slug": "lead", "name": "Лид", "size": "20px" },
        { "slug": "heading", "name": "Заголовок", "size": "48px" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "8px" },
        { "slug": "30", "name": "S", "size": "16px" },
        { "slug": "40", "name": "M", "size": "24px" },
        { "slug": "50", "name": "L", "size": "40px" },
        { "slug": "60", "name": "XL", "size": "64px" }
