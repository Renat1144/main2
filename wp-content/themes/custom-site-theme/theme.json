{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "780px",
      "wideSize": "1180px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "violet-950", "name": "Глубокий фиолетовый", "color": "#160322" },
        { "slug": "violet-900", "name": "Фиолетовый", "color": "#2a074b" },
        { "slug": "violet-800", "name": "Светлый фиолетовый", "color": "#451779" },
        { "slug": "gold-700", "name": "Тёмное золото", "color": "#a66e42" },
        { "slug": "gold-400", "name": "Золото", "color": "#e0bb76" },
        { "slug": "gold-200", "name": "Светлое золото", "color": "#f1ddb4" },
        { "slug": "ivory-100", "name": "Слоновая кость", "color": "#fffaf1" },
        { "slug": "ivory-200", "name": "Тёплый фон", "color": "#f7ecdd" },
        { "slug": "ink", "name": "Основной текст", "color": "#231928" },
        { "slug": "white", "name": "Белый", "color": "#ffffff" }
